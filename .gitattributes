# Normalise text in the repo; check out native on the host.
* text=auto

# Anything executed inside a Linux container must keep LF, or the shebang
# breaks with "bad interpreter: No such file or directory".
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
